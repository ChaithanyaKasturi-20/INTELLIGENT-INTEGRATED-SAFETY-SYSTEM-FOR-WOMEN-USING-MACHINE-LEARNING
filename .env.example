# Set SMTP true and mock false to enable real SMTP; keep mock true for safe local testing.
SOS_SMTP_EMAIL_ENABLED=false
SOS_MOCK_EMAIL_ENABLED=true
# Gmail SMTP sender for SOS email notifications.
# Replace these placeholders locally; never commit real credentials.
PANIC_EMAIL_USER=your-gmail-address@example.com
PANIC_EMAIL_PASS=your-gmail-app-password
# Public HTTPS origin for optional live-location links; email alerts do not depend on it.
SOS_PUBLIC_BASE_URL=
